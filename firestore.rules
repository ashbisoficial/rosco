rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El "código de sala" funciona como token de acceso: solo quien lo conoce
    // puede leer o escribir esa partida. No hay autenticación de usuarios
    // porque el panel de control y el overlay están pensados para uso
    // personal (vos controlando tu propio stream).
    match /rosco_games/{roomId} {
      allow read, write: if true;
    }
  }
}
